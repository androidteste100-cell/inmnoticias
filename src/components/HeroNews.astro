---
import type { Noticia } from "../data/noticias";
const { principal, secundarias } = Astro.props as {principal:Noticia, secundarias:Noticia[]};
---
<section class="grid gap-5 lg:grid-cols-[2fr_1fr]">
<article class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800"><a href={`/noticia/${principal.slug}`}><img src={principal.imagem} width="1400" height="800" fetchpriority="high" alt="" class="aspect-[16/9] w-full object-cover"/></a><div class="p-6"><span class="text-xs font-bold uppercase text-blue-600">{principal.categoria}</span><h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl"><a href={`/noticia/${principal.slug}`}>{principal.titulo}</a></h1><p class="mt-3 text-slate-600 dark:text-slate-400">{principal.resumo}</p><p class="mt-4 text-xs text-slate-500">{principal.autor} · {principal.tempoLeitura} min</p></div></article>
<div class="grid gap-5">{secundarias.map(n=><a href={`/noticia/${n.slug}`} class="flex gap-4 rounded-xl border border-slate-200 p-3 dark:border-slate-800"><img src={n.imagem} width="240" height="160" loading="lazy" alt="" class="h-24 w-32 rounded-lg object-cover"/><div><span class="text-xs font-bold text-blue-600">{n.categoria}</span><h2 class="mt-1 font-bold leading-snug">{n.titulo}</h2><p class="mt-2 text-xs text-slate-500">{n.tempoLeitura} min</p></div></a>)}</div>
</section>