<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95">
<div class="container-page flex h-16 items-center gap-4">
<a href="/" class="shrink-0 text-xl font-black tracking-tight">PORTAL<span class="text-blue-600">NEWS</span></a>
<nav class="hidden flex-1 items-center gap-5 text-sm font-medium lg:flex">
<a href="/#ultimas">Últimas</a><a href="/#brasil">Brasil</a><a href="/#mundo">Mundo</a><a href="/#economia">Economia</a><a href="/#tecnologia">Tecnologia</a><a href="/#esportes">Esportes</a>
