<form action="/" class="hidden sm:block"><input name="q" aria-label="Buscar" placeholder="Buscar" class="w-36 rounded-lg border border-slate-300 bg-transparent px-3 py-2 text-sm dark:border-slate-700"/></form>
<button id="theme-toggle" aria-label="Alternar modo escuro" class="rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700">◐</button>
<button class="lg:hidden rounded-lg border border-slate-300 px-3 py-2 dark:border-slate-700" aria-label="Abrir menu">☰</button>
</div></header>
<script is:inline>
const b=document.querySelector('#theme-toggle');
const saved=localStorage.getItem('theme');
const dark=saved?saved==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
document.documentElement.classList.toggle('dark',dark);
b?.addEventListener('click',()=>{const d=document.documentElement.classList.toggle('dark');localStorage.setItem('theme',d?'dark':'light')});
</script>