---
export async function getStaticPaths() {
  const posts = await Astro.glob('../../../noticias/*.md');
  return posts.map((post) => ({
    params: { slug: post.file.split('/').pop().replace('.md', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <title>{post.frontmatter.title || "Notícia"}</title>
  </head>
  <body>
    <article style="max-width: 800px; margin: 0 auto; padding: 20px;">
      <h1>{post.frontmatter.title}</h1>
      <hr />
      <post.Content />
    </article>
  </body>
</html>
